# syntax = docker/dockerfile:1.4

ARG NODE_VERSION=22
FROM node:${NODE_VERSION}-slim AS base

LABEL fly_launch_runtime="Node.js"
WORKDIR /app
ENV NODE_ENV=production

ARG PNPM_VERSION=11.5.2
RUN npm install -g pnpm@$PNPM_VERSION

# --- Build stage ---
# We consume the docs generated by the CI
FROM base AS build

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential node-gyp pkg-config python-is-python3 && \
    rm -rf /var/lib/apt/lists/*

# pnpm-workspace.yaml carries the pnpm 11 `allowBuilds` settings, so it must be
# present before install or `pnpm install` fails with ERR_PNPM_IGNORED_BUILDS.
COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --prod=false --frozen-lockfile


COPY . .

# `pnpm run build` runs the prebuild hook, which fetches the license-gated React
# Bits Pro components via shadcn. The key is provided as a build secret (passed by
# the fly-deploy `build_secrets` input) so it never lands in an image layer.
RUN --mount=type=secret,id=REACTBITS_LICENSE_KEY \
    REACTBITS_LICENSE_KEY="$(cat /run/secrets/REACTBITS_LICENSE_KEY 2>/dev/null || true)" \
    pnpm run build

# Prune dev deps
RUN pnpm prune --prod

# --- Runtime stage ---
FROM base

COPY --from=build /app /app

EXPOSE 3000
CMD ["pnpm","run","start"]