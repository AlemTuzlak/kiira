{
	"name": "typedown-vscode",
	"displayName": "Typedown",
	"version": "0.1.0",
	"description": "Live type-checking for TypeScript and JavaScript code fences inside Markdown files.",
	"publisher": "AlemTuzlak",
	"private": true,
	"type": "commonjs",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": ["Linters", "Programming Languages"],
	"keywords": ["markdown", "typescript", "docs", "typedown", "validation"],
	"main": "./out/extension.cjs",
	"activationEvents": ["onLanguage:markdown"],
	"contributes": {
		"commands": [
			{
				"command": "typedown.checkCurrentFile",
				"title": "Typedown: Check Current File"
			},
			{
				"command": "typedown.checkWorkspace",
				"title": "Typedown: Check Workspace"
			},
			{
				"command": "typedown.openVirtualFile",
				"title": "Typedown: Open Virtual File For Snippet"
			},
			{
				"command": "typedown.restartServer",
				"title": "Typedown: Restart Typedown Server"
			}
		],
		"configuration": {
			"title": "Typedown",
			"properties": {
				"typedown.enable": {
					"type": "boolean",
					"default": true,
					"description": "Enable Typedown diagnostics in Markdown files."
				},
				"typedown.configPath": {
					"type": "string",
					"default": "typedown.config.ts",
					"description": "Path to the Typedown config file, relative to the workspace root."
				},
				"typedown.debounceMs": {
					"type": "number",
					"default": 300,
					"description": "Delay in milliseconds before re-checking a document after a change."
				},
				"typedown.checkOnSave": {
					"type": "boolean",
					"default": true,
					"description": "Re-check the document when it is saved."
				},
				"typedown.checkOnChange": {
					"type": "boolean",
					"default": true,
					"description": "Re-check the document as it changes (debounced)."
				},
				"typedown.showGeneratedDiagnostics": {
					"type": "boolean",
					"default": false,
					"description": "Show diagnostics that originate from generated fixture code (for debugging)."
				}
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"vscode:prepublish": "pnpm run build",
		"test:unit": "vitest run --passWithNoTests",
		"test:types": "tsc"
	},
	"author": "AlemTuzlak",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AlemTuzlak/typedown.git",
		"directory": "packages/vscode"
	},
	"dependencies": {
		"@typedown/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "22.14.1",
		"@types/vscode": "^1.85.0",
		"tsdown": "^0.22.2",
		"typescript": "^5.4.0",
		"vitest": "^3.1.1"
	}
}
