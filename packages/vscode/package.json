{
	"name": "kiira-vscode",
	"displayName": "Kiira",
	"version": "0.3.0",
	"description": "Live type-checking for TypeScript and JavaScript code fences inside Markdown files.",
	"publisher": "CodeForge",
	"icon": "icon.png",
	"private": true,
	"type": "commonjs",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": ["Linters", "Programming Languages"],
	"keywords": ["markdown", "typescript", "docs", "kiira", "validation"],
	"galleryBanner": {
		"color": "#0d1117",
		"theme": "dark"
	},
	"pricing": "Free",
	"homepage": "https://github.com/AlemTuzlak/kiira#readme",
	"bugs": {
		"url": "https://github.com/AlemTuzlak/kiira/issues"
	},
	"qna": "marketplace",
	"main": "./out/extension.cjs",
	"activationEvents": ["onLanguage:markdown"],
	"contributes": {
		"commands": [
			{
				"command": "kiira.checkCurrentFile",
				"title": "Kiira: Check Current File"
			},
			{
				"command": "kiira.checkWorkspace",
				"title": "Kiira: Check Workspace"
			},
			{
				"command": "kiira.openVirtualFile",
				"title": "Kiira: Open Virtual File For Snippet"
			},
			{
				"command": "kiira.restartServer",
				"title": "Kiira: Restart Kiira Server"
			}
		],
		"configuration": {
			"title": "Kiira",
			"properties": {
				"kiira.enable": {
					"type": "boolean",
					"default": true,
					"description": "Enable Kiira diagnostics in Markdown files."
				},
				"kiira.configPath": {
					"type": "string",
					"default": "kiira.config.ts",
					"description": "Path to the Kiira config file, relative to the workspace root."
				},
				"kiira.debounceMs": {
					"type": "number",
					"default": 300,
					"description": "Delay in milliseconds before re-checking a document after a change."
				},
				"kiira.checkOnSave": {
					"type": "boolean",
					"default": true,
					"description": "Re-check the document when it is saved."
				},
				"kiira.checkOnChange": {
					"type": "boolean",
					"default": true,
					"description": "Re-check the document as it changes (debounced)."
				},
				"kiira.showGeneratedDiagnostics": {
					"type": "boolean",
					"default": false,
					"description": "Show diagnostics that originate from generated fixture code (for debugging)."
				}
			}
		}
	},
	"scripts": {
		"build": "tsdown && node scripts/copy-ts-lib.mjs",
		"vscode:prepublish": "pnpm run build",
		"package": "vsce package --no-dependencies",
		"test:unit": "vitest run --passWithNoTests",
		"test:types": "tsc"
	},
	"author": "AlemTuzlak",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AlemTuzlak/kiira.git",
		"directory": "packages/vscode"
	},
	"dependencies": {
		"kiira-core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "22.14.1",
		"@types/vscode": "^1.85.0",
		"@vscode/vsce": "^3.6.0",
		"ovsx": "^0.10.2",
		"tsdown": "^0.22.2",
		"typescript": "^5.4.0",
		"vitest": "^3.1.1"
	}
}
