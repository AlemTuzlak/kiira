{
	"compilerOptions": {
		"target": "ES2022",
		"moduleResolution": "Bundler",
		"module": "ESNext",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["vitest/globals", "node", "vscode"],
		"rootDir": ".",
		"outDir": "./out",
		"noEmit": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "out"]
}
