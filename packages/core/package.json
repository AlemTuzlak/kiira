{
	"name": "kiira-core",
	"version": "0.3.0",
	"description": "Core engine for Kiira: extract code fences from Markdown, type-check them, and map diagnostics back to source.",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"prepublishOnly": "pnpm run build && pnpm run test:exports",
		"test:unit": "vitest run --passWithNoTests",
		"test:cov": "vitest run --coverage",
		"test:types": "tsc",
		"test:publint": "publint --strict",
		"test:exports": "attw --pack ."
	},
	"author": "AlemTuzlak",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AlemTuzlak/kiira.git",
		"directory": "packages/core"
	},
	"bugs": {
		"url": "https://github.com/AlemTuzlak/kiira/issues"
	},
	"files": ["dist"],
	"homepage": "https://github.com/AlemTuzlak/kiira#readme",
	"publishConfig": {
		"provenance": true
	},
	"dependencies": {
		"jiti": "^2.4.2",
		"typescript": "^5.4.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.17.4",
		"@types/mdast": "^4.0.4",
		"@types/node": "22.14.1",
		"@types/picomatch": "^3.0.1",
		"@vitest/coverage-v8": "^3.1.1",
		"mdast-util-from-markdown": "^2.0.2",
		"mdast-util-mdx": "^3.0.0",
		"micromark-extension-mdxjs": "^3.0.0",
		"picomatch": "^4.0.2",
		"tinyglobby": "^0.2.12",
		"tsdown": "^0.22.2",
		"vitest": "^3.1.1"
	}
}
